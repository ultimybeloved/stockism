rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is admin
    // Note: Admin UID should be set via Firebase environment config in production
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == '4usiVxPmHLhmitEKH2HfCpbx4Yi1';
    }

    // ============================================
    // USERNAMES COLLECTION (case-insensitive uniqueness)
    // ============================================

    match /usernames/{username} {
      // Anyone can read (for availability checking)
      allow read: if true;

      // Only Cloud Functions can write (via admin SDK)
      // This ensures atomic username reservation
      allow write: if false;
    }

    // ============================================
    // USER DOCUMENTS
    // ============================================

    match /users/{userId} {
      // Read access:
      // - Owner can read all their own data
      // - Admin can read all user data
      // - Leaderboard now uses Cloud Function for public data only
      allow read: if isOwner(userId) || isAdmin();

      // User creation is now handled by Cloud Functions
      // This ensures atomic username uniqueness checking
      // Direct creation is disabled - use createUser Cloud Function
      allow create: if false;

      // SECURITY FIX: Only allow safe field updates (not cash/holdings/shorts/margin)
      // Trading data must be updated via executeTrade Cloud Function
      allow update: if isAdmin() || (isOwner(userId) && validateSafeUserUpdate());

      // Admin can delete user documents (for cleanup)
      allow delete: if isAdmin();
    }

    // Allowlist: a non-admin user may only change this fixed set of harmless
    // preference / UI fields on their own document. Everything else — cash,
    // holdings, shorts, margin, missions, prediction (eventPositions), check-in
    // state, display name, etc. — is managed server-side via Cloud Functions
    // (the Admin SDK bypasses these rules).
    //
    // This is an allowlist on purpose. The previous version was a denylist that
    // had to name every protected field, and it kept drifting out of sync with
    // the schema — money fields like eventPositions, lastCheckin, and
    // checkinStreak were left writable and became cash-printing exploits. With
    // an allowlist, any new server-managed field is locked by default and a new
    // client-writable preference is the only thing that ever needs adding here.
    //
    // Every entry below corresponds to a real client-side write to the user's
    // own doc. If you add a new preference the client writes directly, add its
    // top-level key here too.
    function validateSafeUserUpdate() {
      return safeUserKeysOnly() && titleIsOwned();
    }

    // activeTitle is on the allowlist so the client can equip a season title
    // without a Cloud Function round trip, but the allowlist only says WHICH key
    // may change, not what may go in it — any string at all was accepted, for a
    // field rendered next to the player's name on the leaderboard. A title may
    // only be cleared, or set to one the server already granted. ownedTitles and
    // titleMeta stay server-only (adminEndSeason writes both).
    function titleIsOwned() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeTitle'])
        || request.resource.data.activeTitle == null
        || (request.resource.data.activeTitle is string
            && resource.data.get('ownedTitles', []).hasAny([request.resource.data.activeTitle]));
    }

    function safeUserKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'darkMode',                  // theme toggle (App.jsx)
        'colorBlindMode',            // accessibility toggle (ProfileSettings/ProfileModal)
        'isPublic',                  // public profile toggle (ProfileSettings/ProfileModal)
        'onboardingComplete',        // first-run tutorial flag (App.jsx)
        'marginTutorialCompleted',   // margin tutorial flag (App.jsx)
        'ladderTutorial2Completed',  // ladder tutorial flag (LadderGame)
        'watchlist',                 // personal watchlist (App.jsx)
        'drip',                      // per-ticker dividend reinvest toggles (App.jsx/StockPage)
        'displayedShopPins',         // pin display order (usePinShop)
        'displayedAchievementPins',  // pin display order (usePinShop)
        'displayCrewPin',            // crew pin display toggle (usePinShop)
        'activeCosmetics',           // equipped cosmetics (usePinShop)
        'cosmeticStyle',             // Split Flap / Bull / Bear / backdrop tint choices (usePinShop);
                                     // the server only publishes known values
        'activeTitle'                // equipped season title (ProfileSettings) —
                                     // ownedTitles stays server-only, and the
                                     // client can only equip one it already owns
      ]);
    }
    
    // ============================================
    // MARKET DATA
    // ============================================
    
    match /market/{document} {
      // Everyone can read market data
      allow read: if true;

      // SECURITY FIX: Only Cloud Functions (via Admin SDK) can write market data
      // This prevents price manipulation via direct client writes
      allow update: if isAdmin(); // Admin only (Cloud Functions bypass rules)

      // Only admin can create market documents
      allow create: if isAdmin();

      // Price history archive sub-collection
      match /price_history/{ticker} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Daily closing prices, one document per calendar month. Same access as
      // the price history it complements: public to read, server-written only.
      match /daily_closes/{monthId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============================================
    // LEADERBOARD SNAPSHOTS
    // ============================================
    // Precomputed top-50 docs written by the getLeaderboard function (Admin
    // SDK). Public read so clients render instantly without a function call.
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Finished seasons — permanent public history of standings and tiers.
    // Written only by adminEndSeason via the Admin SDK.
    match /seasonResults/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================
    // DIVIDEND CONFIG
    // ============================================
    // Public read so the client can show tier badges. Admin-only writes
    // via the admin panel (tier overrides) or via Cloud Functions (run logs).
    match /dividendConfig/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // PREDICTIONS
    // ============================================
    
    match /predictions/{document} {
      // Everyone can read predictions
      allow read: if true;
      
      // Only admin can create/delete predictions
      allow create, delete: if isAdmin();
      
      // All updates go through Cloud Functions (placeBet, claimPredictionPayout)
      // Direct client writes are blocked to prevent bet manipulation
      allow update: if isAdmin();
    }
    
    // ============================================
    // PRICE HISTORY (if stored separately)
    // ============================================
    
    match /priceHistory/{document} {
      allow read: if true;
      allow write: if false; // Cloud Functions use Admin SDK, bypass rules
    }
    
    // ============================================
    // LADDER GAME COLLECTIONS
    // ============================================

    // Global ladder game data (history, stats)
    match /ladderGame/{document} {
      // Everyone can read global history
      allow read: if true;

      // Only Cloud Functions can write (server-side game logic)
      allow write: if false;
    }

    // Individual ladder game user data
    match /ladderGameUsers/{userId} {
      // Everyone can read (for leaderboard)
      allow read: if true;

      // Only Cloud Functions can write (server-side balance updates)
      allow write: if false;
    }

    // ============================================
    // LIMIT ORDERS
    // ============================================

    match /limitOrders/{orderId} {
      // Users can read their own orders, admins can read all
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Limit order creation now handled by createLimitOrder Cloud Function
      allow create: if false;

      // Users can only cancel their own orders (status change only), admins can update any
      allow update: if isAdmin() ||
                       (isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        validateLimitOrderUpdate());

      // Only admins can delete orders
      allow delete: if isAdmin();
    }

    // Limit order updates: users can only cancel a live order. A partly filled
    // order is still live (the sweep keeps filling it), so it can be cancelled
    // too; before 2026-10-13 it couldn't, and its remainder sat on the book for
    // up to 90 days blocking shorts and new sell orders on that stock.
    function validateLimitOrderUpdate() {
      let oldData = resource.data;
      let newData = request.resource.data;
      return (
        newData.status == 'CANCELED' &&
        oldData.status in ['PENDING', 'PARTIALLY_FILLED'] &&
        // Nothing but the status and its timestamp may change
        newData.diff(oldData).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
    }

    // ============================================
    // PRE-MARKET ORDERS
    // ============================================

    match /preMarketOrders/{orderId} {
      // Owner and admin only. Until 2026-10-13 any signed-in player could read
      // every order, user IDs included. The indicative opening price reads the
      // per-ticker totals in market/preMarketBook instead.
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      // All writes go through Cloud Functions (Admin SDK bypasses rules)
      allow create, update, delete: if false;
    }

    // ============================================
    // TRADES COLLECTION (audit log)
    // ============================================

    match /trades/{tradeId} {
      // Admin can read all trades
      // Users can read their own trades (for trade history)
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);

      // Only Cloud Functions can write (server-side trade logging)
      allow write: if false;
    }

    // ============================================
    // ADMIN-ONLY COLLECTIONS
    // ============================================

    // IP tracking for multi-account abuse detection (Cloud Functions only)
    match /ipTracking/{document} {
      allow read, write: if false;
    }

    // Discord re-link tombstones — blocks a deleted account's Discord from
    // immediately verifying a new one (Cloud Functions only).
    match /discordTombstones/{discordId} {
      allow read, write: if false;
    }

    // Permanent Discord → account bindings, written when a player unlinks their
    // own Discord. Keeps a released Discord from verifying a different account
    // (Cloud Functions only — a client write here would hand away the binding).
    match /discordBindings/{discordId} {
      allow read, write: if false;
    }

    // Discord details parked between OAuth and the new player choosing a name.
    // Cloud Functions only — a client write here would let someone attach any
    // Discord ID to their own signup.
    match /discordPending/{uid} {
      allow read, write: if false;
    }

    match /admin/{document} {
      allow read, write: if isAdmin();
    }

    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // BANNED USERS
    // ============================================

    match /banned_users/{userId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // WATCHLIST COLLECTIONS
    // ============================================

    match /watchedUsers/{userId} {
      allow read, write: if isAdmin();
    }

    match /watchedIPs/{ipId} {
      allow read, write: if isAdmin();
    }

    // Long-term market history (buys, sells, payouts, shares lost to account
    // deletion). Players may read their own records; only Cloud Functions write.
    match /eventTrades/{recordId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // The money ledger: one entry per change to a player's cash, ladder balance
    // or granted shares. Players read their own; only Cloud Functions write.
    match /ledger/{entryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Full copies of deleted accounts. Admin only: they hold IPs and Discord IDs.
    match /deletedUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Alerts are write-only from Cloud Functions (admin SDK bypasses rules)
    match /watchlist_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // PORTFOLIO HISTORY (per-user subcollection)
    // ============================================
    match /users/{userId}/portfolioHistory/{entryId} {
      // Users can read their own history; Cloud Functions write via admin SDK
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================
    // NOTIFICATIONS (per-user subcollection)
    // ============================================
    match /users/{userId}/notifications/{notificationId} {
      // Users can read and delete their own notifications
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      // Users can update read status only
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Only Cloud Functions can create (via admin SDK)
      allow create: if false;
    }

    // ============================================
    // PRICE ALERTS (per-user subcollection)
    // ============================================
    match /users/{userId}/priceAlerts/{alertId} {
      // Users can read their own alerts
      allow read: if isOwner(userId);
      // Only Cloud Functions can create/update (via admin SDK)
      allow create, update: if false;
      // Users can delete their own alerts
      allow delete: if isOwner(userId);
    }

    // ============================================
    // TRADE FEED: closed to players since 2026-10-20. Nothing in the app reads
    // it, and while it was open anyone could watch every trade live (name,
    // shares, price) and trade against it. Cloud Functions only.
    // ============================================
    match /feed/{feedId} {
      allow read, write: if false;
    }

    // ============================================
    // AUCTIONS: the auction itself is public (bids show bidder numbers only).
    // Who is behind each number is server-only. Cloud Functions write both.
    // ============================================
    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if false;
    }
    match /auctionBidders/{auctionId} {
      allow read, write: if false;
    }

    // ============================================
    // CREW MISSIONS (shared weekly goals)
    // ============================================
    match /crewMissions/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // CIRCUIT BREAKER LOG
    // ============================================
    match /circuitBreakerLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ADMIN CASH AUDIT LOG
    // ============================================
    // Every manual balance change, with the admin's internal memo. Read through
    // the admin-gated callable only: the memos are private notes and are never
    // shown to the player the entry is about.
    match /adminCashLog/{entryId} {
      allow read, write: if false;
    }

    // Who gifted what to whom, with the giver's connection. Read through the
    // admin-gated adminListGifts callable only: it holds network addresses.
    match /giftLog/{entryId} {
      allow read, write: if false;
    }

    // Every admin change to a player or the market, with before and after.
    // Read through the admin-gated adminListLog callable only: it holds
    // private fields such as Discord IDs and moderation notes. The admin panel
    // may append entries for its browser-side tools (src/features/admin/utils/
    // panelLog.ts), stamped with its own uid and the server time; nothing may
    // change or remove an entry once written.
    match /adminLog/{entryId} {
      allow read, update, delete: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'by', 'uid', 'name', 'before', 'after', 'detail', 'source', 'at'])
        && request.resource.data.action is string
        && request.resource.data.by == request.auth.uid
        && request.resource.data.source == 'panel'
        && request.resource.data.at == request.time;
    }

    // ============================================
    // ADMIN-MANAGED DISCORD MESSAGES
    // ============================================
    // Records of bot messages the admin panel can edit. Cloud Functions only:
    // the panel reads them through admin-gated callables, never directly, and
    // nothing here is meant for players.
    match /discordMessages/{messageId} {
      allow read, write: if false;
    }

    // ============================================
    // DISCORD LINK CODES
    // ============================================
    // Single-use handoff codes for the Discord OAuth flow. Cloud Functions only:
    // a readable code would let someone attach their Discord to that account.
    match /discordLinkNonces/{state} {
      allow read, write: if false;
    }

    // The /welcome week, keyed by Discord ID so a Discord account can only run
    // it once. Cloud Functions only: the player's progress is mirrored on their
    // own user doc (welcomeStreak) for the site to show.
    match /welcomeStreaks/{discordId} {
      allow read, write: if false;
    }

    // Admin command panel data, Cloud Functions only: private player notes,
    // who uses the Discord bot, and the saved daily money flow summaries.
    match /adminNotes/{uid} {
      allow read, write: if false;
    }
    match /discordActivity/{discordId} {
      allow read, write: if false;
    }
    match /ledgerDaily/{day} {
      allow read, write: if false;
    }

    // Bot engine state, Cloud Functions only: the hidden storylines (a player
    // who could read them could trade ahead of them) and the admin-confirmed
    // manipulator list.
    match /botState/{document} {
      allow read, write: if false;
    }
  }
}
