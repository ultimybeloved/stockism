{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests index fixture arrays and maps freely, and an out-of-range read fails
    // the assertion anyway, so the per-index undefined check is relaxed here only.
    "noUncheckedIndexedAccess": false,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src"],
  "exclude": []
}
