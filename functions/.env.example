# Backend environment. Copy to functions/.env and fill in the real values.
#
# functions/.env is gitignored, so a fresh clone never has it. A functions
# deploy UPLOADS this file and REPLACES the entire live environment with it,
# so deploying without it wipes every value below from production while
# still reporting a successful deploy. `npm run check:env` blocks that.
#
# Get the real values from the main dev machine (password manager or USB).
# The bot token and client secret are live credentials: do not send them
# through email or Discord.

# --- Required: the deploy check fails without these ---
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_SIGNUP_CHANNEL_ID=your_signup_channel_id_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_PUBLIC_KEY=your_public_key_here
ADMIN_DISCORD_USER_ID=your_discord_user_id_here
SENTRY_DSN=your_sentry_dsn_here

# --- Optional ---
# Crew-head Discord roles stay dormant until this and the role IDs in
# functions/constants.js are filled in.
# DISCORD_GUILD_ID=
# Falls back to the hardcoded admin UID in functions/constants.js.
# ADMIN_UID=
