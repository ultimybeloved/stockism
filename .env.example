# Firebase Configuration
# Copy this file to .env.local and fill in your values
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Check (ReCAPTCHA v3)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Discord sign-in button (the Stockism login app's client ID)
VITE_DISCORD_CLIENT_ID=your_discord_client_id

# Error reports (Sentry). Leave empty to switch them off.
VITE_SENTRY_DSN=your_sentry_dsn

# Local dev only: a fixed App Check debug token registered in the Firebase console
# VITE_APPCHECK_DEBUG_TOKEN=your_debug_token
