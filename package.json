{
  "name": "stockism",
  "version": "2.0.0",
  "description": "Lookism Character Stock Exchange - Community Edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "npm run build:functions && firebase emulators:start --only auth,firestore,functions",
    "seed:emulator": "node scripts/seed-emulator.cjs",
    "build": "vite build",
    "build:functions": "node -e \"require('fs').rmSync('functions/lib', { recursive: true, force: true })\" && tsc -p functions",
    "preview": "vite preview",
    "sync:chars": "node scripts/sync-chars.cjs",
    "check:functions": "npm run build:functions && node scripts/check-function-exports.cjs",
    "check:env": "node scripts/check-env.cjs",
    "check:data": "node scripts/check-data.cjs",
    "check:sync": "node scripts/check-sync.cjs",
    "audit:halt": "node scripts/halt-price-audit.cjs",
    "status:market": "tsx scripts/market-status.cjs",
    "discord:commands": "node scripts/register-discord-commands.cjs",
    "discord:emojis": "node scripts/sync-crew-emojis.cjs",
    "test:discord": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-discord-commands-emulator.cjs\"",
    "test:discord:endpoint": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-discord-endpoint-emulator.cjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --config firebase.emulator-test.json --only auth,firestore \"tsx scripts/test-rules-emulator.mjs\"",
    "test:ipcap": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-ipcap-emulator.mjs\"",
    "test:trading": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-trading-emulator.cjs\"",
    "test:limitorders": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/seed-emulator.cjs && tsx scripts/test-limitorders-emulator.cjs\"",
    "test:premarket": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/seed-emulator.cjs && tsx scripts/test-premarket-emulator.cjs\"",
    "test:exploits": "firebase emulators:exec --config firebase.emulator-test.json --only auth,firestore \"tsx scripts/seed-emulator.cjs && tsx scripts/test-exploit-fixes-emulator.cjs\"",
    "loadtest:trades": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/loadtest-trades-emulator.cjs\"",
    "loadtest:txn": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/loadtest-txn-probe.cjs\"",
    "test:dividends": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-dividends-emulator.cjs\"",
    "test:ladder": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-ladder-emulator.cjs\"",
    "test:eventmarket": "npm run build:functions && firebase emulators:exec --only auth,firestore,functions \"tsx scripts/seed-emulator.cjs && tsx scripts/test-event-market.cjs\"",
    "test:drophalt": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-drop-halt-emulator.cjs\"",
    "test:collapse": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-review-collapse-emulator.cjs\"",
    "test:pricehistory": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/seed-emulator.cjs && tsx scripts/test-price-history-split-emulator.cjs\"",
    "test:loyalty": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-loyalty-notify-emulator.cjs\"",
    "test:crewroles": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-crew-roles-emulator.cjs\"",
    "test:crewswitch": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-crew-switch-emulator.cjs\"",
    "test:season": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-season-emulator.cjs\"",
    "test:coord": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-coord-emulator.cjs\"",
    "test:split": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-split-emulator.cjs\"",
    "lint": "eslint src",
    "deploy:functions": "npm run build:functions && node scripts/deploy-functions.cjs",
    "test:rename": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"tsx scripts/test-rename-ticker-emulator.cjs\"",
    "lint:functions": "eslint functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p functions --noEmit"
  },
  "dependencies": {
    "@sentry/react": "^10.52.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^11.11.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.1.4",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "functions/src/**/*.{js,ts}": [
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "*.{cjs,mjs}": "prettier --write",
    "scripts/**/*.{js,cjs,mjs}": "prettier --write",
    "*.{json,css,yml,yaml,html}": "prettier --write"
  }
}
