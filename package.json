{
  "name": "stockism",
  "version": "2.0.0",
  "description": "Lookism Character Stock Exchange - Community Edition",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "seed:emulator": "node scripts/seed-emulator.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "sync:chars": "node scripts/sync-chars.cjs",
    "check:functions": "node scripts/check-function-exports.cjs",
    "check:env": "node scripts/check-env.cjs",
    "check:data": "node scripts/check-data.cjs",
    "check:sync": "node scripts/check-sync.cjs",
    "audit:halt": "node scripts/halt-price-audit.cjs",
    "status:market": "node scripts/market-status.cjs",
    "discord:commands": "node scripts/register-discord-commands.cjs",
    "test:discord": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-discord-commands-emulator.cjs\"",
    "test:discord:endpoint": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-discord-endpoint-emulator.cjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --config firebase.emulator-test.json --only auth,firestore \"node scripts/test-rules-emulator.mjs\"",
    "test:ipcap": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-ipcap-emulator.mjs\"",
    "test:trading": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-trading-emulator.cjs\"",
    "test:limitorders": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/seed-emulator.cjs && node scripts/test-limitorders-emulator.cjs\"",
    "test:premarket": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/seed-emulator.cjs && node scripts/test-premarket-emulator.cjs\"",
    "test:exploits": "firebase emulators:exec --config firebase.emulator-test.json --only auth,firestore \"node scripts/seed-emulator.cjs && node scripts/test-exploit-fixes-emulator.cjs\"",
    "loadtest:trades": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/loadtest-trades-emulator.cjs\"",
    "loadtest:txn": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/loadtest-txn-probe.cjs\"",
    "test:dividends": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-dividends-emulator.cjs\"",
    "test:ladder": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-ladder-emulator.cjs\"",
    "test:eventmarket": "firebase emulators:exec --only auth,firestore,functions \"node scripts/seed-emulator.cjs && node scripts/test-event-market.cjs\"",
    "test:drophalt": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-drop-halt-emulator.cjs\"",
    "test:collapse": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-review-collapse-emulator.cjs\"",
    "test:pricehistory": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/seed-emulator.cjs && node scripts/test-price-history-split-emulator.cjs\"",
    "test:loyalty": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-loyalty-notify-emulator.cjs\"",
    "test:crewroles": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-crew-roles-emulator.cjs\"",
    "test:crewswitch": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-crew-switch-emulator.cjs\"",
    "lint": "eslint src --ext .js,.jsx",
    "deploy:functions": "node scripts/deploy-functions.cjs",
    "test:rename": "firebase emulators:exec --config firebase.emulator-test.json --only firestore \"node scripts/test-rename-ticker-emulator.cjs\""
  },
  "dependencies": {
    "@sentry/react": "^10.52.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "firebase-admin": "^11.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vitest": "^4.1.5"
  }
}
