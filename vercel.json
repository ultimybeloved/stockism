{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/snapshot",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/publicSnapshot"
    },
    {
      "source": "/snapshot/:path*",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/publicSnapshot/:path*"
    },
    {
      "source": "/((?!snapshot|sitemap\\.xml|robots\\.txt|privacy\\.html|terms\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
