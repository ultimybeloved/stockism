{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/snapshot",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/publicSnapshot"
    },
    {
      "source": "/snapshot/:path*",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/publicSnapshot/:path*"
    },
    {
      "source": "/auth/discord",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/discordAuth?via=site"
    },
    {
      "source": "/auth/discord-link",
      "destination": "https://us-central1-stockism-abb28.cloudfunctions.net/discordLink?via=site"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://stockism-abb28.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://stockism-abb28.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!snapshot|auth/discord|__/|sitemap\\.xml|robots\\.txt|privacy\\.html|terms\\.html|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!__/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.ingest.us.sentry.io https://*.ingest.sentry.io https://apis.google.com https://www.google.com; frame-src 'self' https://stockism-abb28.firebaseapp.com https://discord.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri https://o4511358239571968.ingest.us.sentry.io/api/4511358245863424/security/?sentry_key=140b4207fb6e38984ef843b7385fa8f6"
        }
      ]
    }
  ]
}
